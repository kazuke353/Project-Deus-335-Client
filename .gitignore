# This repo is the Deus client download (GitHub's "Download ZIP"): Wow.exe, the Deus loader
# dinput8.dll beside it, and the realm's patch archives in Data/. The website serves the same
# files to the updater (/client/files/), so committing here and publishing are the same files.
/.cache-bump

# Stock 3.3.5a client files; they come from the base client install.

# Base game archives
/Data/common.MPQ
/Data/common-2.MPQ
/Data/expansion.MPQ
/Data/lichking.MPQ
/Data/patch.MPQ
/Data/patch-2.MPQ
/Data/patch-3.MPQ
/Data/enUS/

# Stock binaries (the Deus dinput8.dll is ours)
/*.dll
!/dinput8.dll
/Repair.exe
/WowError.exe
/Launcher.exe
/BackgroundDownloader.exe

# Backups of Wow.exe
*.bak

# Runtime and per-user data
/Cache/
/Logs/
/Errors/
/Screenshots/
/WTF/
/Interface/
*.dxvk-cache

# Only Wow.exe and the README belong to this repo. The patch archives in Data/ stay in this
# folder because the website serves them from here (/client/files/, read by the Wow.exe
# updater), but they are not versioned: players get them from the updater.
/Data/patch-*.MPQ
/.cache-bump

# Stock 3.3.5a client files; they come from the base client install.

# Base game archives
/Data/common.MPQ
/Data/common-2.MPQ
/Data/expansion.MPQ
/Data/lichking.MPQ
/Data/patch.MPQ
/Data/patch-2.MPQ
/Data/patch-3.MPQ
/Data/enUS/

# Stock binaries
/*.dll
/Repair.exe
/WowError.exe
/Launcher.exe
/BackgroundDownloader.exe

# Backups of Wow.exe
*.bak

# Runtime and per-user data
/Cache/
/Logs/
/Errors/
/Screenshots/
/WTF/
/Interface/
*.dxvk-cache
